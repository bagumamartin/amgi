/* Permission prompts and the display name.
 *
 * The prompt is the first thing a user reads from this app on a device where
 * they do not read English, so it is a real translation, not a copy of
 * Info.plist. Add one folder per shipped language; a missing translation falls
 * back to the English value in Info.plist, which is correct rather than empty.
 *
 * Only top-level string values can be localized this way — see the en copy
 * for why the document-type and UTType names are not here.
 */
"CFBundleDisplayName" = "Ijuka";
"CFBundleName" = "Ijuka";

"NSCameraUsageDescription" = "Ijuka dùng máy ảnh để thêm hình ảnh vào thẻ của bạn.";
"NSMicrophoneUsageDescription" = "Ijuka dùng micrô để ghi âm thanh ghi chú cho thẻ của bạn.";
"NSPhotoLibraryUsageDescription" = "Ijuka hiển thị ảnh gần đây của bạn để bạn có thể thêm hình ảnh vào thẻ.";
