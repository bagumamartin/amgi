<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).widget-refresh</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).automatic-sync</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Ijuka</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>apkg</string>
				<string>colpkg</string>
			</array>
			<key>CFBundleTypeIconName</key>
			<string>AppIcon</string>
			<key>CFBundleTypeName</key>
			<string>Anki Package</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bagumamartin.ijuka.anki-package</string>
				<string>com.bagumamartin.ijuka.anki-collection-package</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>csv</string>
				<string>tsv</string>
				<string>txt</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Anki Text Import</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
				<string>public.plain-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>anki-json</string>
			</array>
			<key>CFBundleTypeIconName</key>
			<string>AppIcon</string>
			<key>CFBundleTypeName</key>
			<string>Anki JSON</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bagumamartin.ijuka.anki-json</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>epub</string>
			</array>
			<key>CFBundleTypeIconName</key>
			<string>AppIcon</string>
			<key>CFBundleTypeName</key>
			<string>EPUB Book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<!--
				PDF, as an Alternate handler.

				Alternate rather than Owner or Default on purpose: Preview, Acrobat
				and the built-in Quick Look all handle PDFs, and claiming more
				than Alternate would make this app the default PDF reader on the
				device, which is not what a reading app with Anki integration
				should be.
			-->
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pdf</string>
			</array>
			<key>CFBundleTypeIconName</key>
			<string>AppIcon</string>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>amgi</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Ijuka uses the camera to add pictures to your cards.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ijuka uses the microphone to record audio notes for your cards.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ijuka shows your recent photos so you can add pictures to your cards.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/SarasaMonoK-Regular.ttf</string>
		<string>Fonts/NanumMyeongjo-Regular.ttf</string>
		<string>Fonts/NanumGothic-Regular.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Anki Deck Package</string>
			<key>UTTypeIdentifier</key>
			<string>com.bagumamartin.ijuka.anki-package</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkg</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.anki.deck-package</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Anki Collection Package</string>
			<key>UTTypeIdentifier</key>
			<string>com.bagumamartin.ijuka.anki-collection-package</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>colpkg</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.anki.collection-package</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Anki JSON Interchange Data</string>
			<key>UTTypeIdentifier</key>
			<string>com.bagumamartin.ijuka.anki-json</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>anki-json</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.anki+json</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
