    "Wait for audio before answering": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozás a hang lejátszására válaszadás előtt"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
