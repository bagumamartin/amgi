    },
    "You have a draft for this card. Resume it, or start from the saved card — the draft stays in Drafts until you save or delete it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már van piszkozatod ehhez a kártyához. Folytasd, vagy indulj ki a mentett kártyából — a piszkozat a Piszkozatok között marad, amíg el nem mented vagy nem törlöd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có bản nháp cho thẻ này. Tiếp tục hoặc bắt đầu từ thẻ đã lưu — bản nháp vẫn ở mục Bản nháp cho đến khi bạn lưu hoặc xóa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un brouillon pour cette carte. Reprenez-le ou repartez de la carte enregistrée ; le brouillon restera dans Brouillons jusqu’à son enregistrement ou sa suppression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un borrador para esta tarjeta. Reanúdalo o empieza desde la tarjeta guardada; permanecerá en Borradores hasta que lo guardes o lo elimines."
          }
        }
      }
    },
    "You have a draft for this deck. Resume it, or start a new note — the draft stays in Drafts until you add it or delete it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már van piszkozatod ehhez a paklihoz. Folytasd, vagy kezdj új jegyzetet — a piszkozat a Piszkozatok között marad, amíg hozzá nem adod vagy nem törlöd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có bản nháp cho bộ thẻ này. Tiếp tục hoặc tạo ghi chú mới — bản nháp vẫn ở mục Bản nháp cho đến khi bạn thêm hoặc xóa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un brouillon pour ce paquet. Reprenez-le ou créez une note ; le brouillon restera dans Brouillons jusqu’à son ajout ou sa suppression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un borrador para este mazo. Reanúdalo o crea una nota nueva; permanecerá en Borradores hasta que la añadas o la elimines."
          }
        }
      }
    },
    "You have unsaved changes. Discard them?": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem mentett módosításaid vannak. Eldobod őket?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thay đổi chưa lưu. Bỏ các thay đổi này?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications ne sont pas enregistrées. Les abandonner ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes cambios sin guardar. ¿Descartarlos?"
          }
        }
      }
    },
    "Young": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
