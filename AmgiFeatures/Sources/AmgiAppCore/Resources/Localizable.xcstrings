    "Weights": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Súlyok"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng số"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
