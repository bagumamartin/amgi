    "Use the arrow keys to inspect values. Press Home or End to jump; Escape to clear.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyílbillentyűkkel vizsgálhatod az értékeket. A Home vagy End az elejére, illetve a végére ugrik; az Escape töröl."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng các phím mũi tên để xem giá trị. Nhấn Home hoặc End để đến đầu hoặc cuối; Escape để xóa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches pour examiner les valeurs. Appuyez sur Début ou Fin pour vous déplacer ; Échap pour effacer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las flechas para inspeccionar los valores. Pulsa Inicio o Fin para saltar; Escape para borrar."
