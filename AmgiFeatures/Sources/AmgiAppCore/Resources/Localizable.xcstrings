    "Amgi works fully offline. Add a server only if you want to sync with AnkiWeb or a self-hosted instance.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Amgi internet nélkül is teljes értékűen működik. Csak akkor adj hozzá szervert, ha szinkronizálni szeretnél az AnkiWebbel vagy egy saját üzemeltetésű szerverrel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Amgi hoạt động đầy đủ khi ngoại tuyến. Chỉ thêm máy chủ nếu bạn muốn đồng bộ với AnkiWeb hoặc máy chủ tự vận hành."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amgi fonctionne entièrement hors ligne. Ajoutez un serveur uniquement si vous souhaitez synchroniser avec AnkiWeb ou un serveur auto-hébergé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amgi funciona completamente sin conexión. Añade un servidor solo si quieres sincronizar con AnkiWeb o con una instancia propia."
          }
        }
      }
    },
