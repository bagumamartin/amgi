    "Tap and drag to draw a mask. Drag handles to resize.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints és húzd az ujjad a kitakarás megrajzolásához. A fogantyúkkal módosíthatod a méretét."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và kéo để vẽ vùng che. Kéo các nút điều khiển để đổi kích thước."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et faites glisser pour dessiner un masque. Faites glisser les poignées pour le redimensionner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y arrastra para dibujar una máscara. Arrastra los controles para cambiar su tamaño."
          }
        }
      }
    },
    "Tap the bookmark icon in the top toolbar to save your place.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyed mentéséhez koppints a könyvjelző ikonra a felső eszköztáron."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm biểu tượng dấu trang trên thanh công cụ phía trên để lưu vị trí đọc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’icône de signet dans la barre d’outils supérieure pour enregistrer votre position."
          }
        },
        "es": {
