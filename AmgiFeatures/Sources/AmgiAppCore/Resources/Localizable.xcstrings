    "Frees the on-device storage. The app keeps working with basic icon matching, and you can re-download anytime.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felszabadítja a tárhelyet az eszközön. Az alkalmazás alapvető ikonegyezéssel tovább működik, a modell pedig bármikor újra letölthető."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải phóng dung lượng trên thiết bị. Ứng dụng vẫn hoạt động với khả năng so khớp biểu tượng cơ bản; bạn có thể tải lại bất cứ lúc nào."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère l’espace de stockage sur l’appareil. L’app continue de fonctionner avec la correspondance basique des icônes ; vous pouvez télécharger à nouveau le modèle à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera el almacenamiento del dispositivo. La app sigue funcionando con la búsqueda básica de iconos y puedes volver a descargarlo cuando quieras."
          }
        }
      }
    },
