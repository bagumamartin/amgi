    "Import Yomitan-format dictionary ZIP archives. Use Update to refresh a saved search from the current query; archive version metadata is retained for future incremental updates.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálj Yomitan-formátumú szótár-ZIP-archívumokat. A Frissítés gombbal az aktuális lekérdezés alapján frissítheted a mentett keresést; az archívum verzióadatai megmaradnak a későbbi növekményes frissítésekhez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tệp ZIP từ điển định dạng Yomitan. Dùng Cập nhật để làm mới tìm kiếm đã lưu theo truy vấn hiện tại; thông tin phiên bản lưu trữ được giữ lại cho các lần cập nhật tăng dần sau này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des archives ZIP de dictionnaires au format Yomitan. Utilisez « Mettre à jour » pour actualiser une recherche enregistrée à partir de la requête actuelle ; les métadonnées de version sont conservées pour de futures mises à jour incrémentielles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa archivos ZIP de diccionarios en formato Yomitan. Usa Actualizar para renovar una búsqueda guardada con la consulta actual; se conservan los metadatos de versión del archivo para futuras actualizaciones incrementales."
          }
        }
      }
    },
