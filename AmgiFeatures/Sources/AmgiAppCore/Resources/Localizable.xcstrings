    "Replaces tag text across the scope (desktop Tags target).": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címkeszöveget a teljes hatókörben cseréli le (az asztali verzióban a Címkék a cél)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay nội dung nhãn trong phạm vi đã chọn (đích Nhãn trên máy tính)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le texte des étiquettes dans tout le périmètre (cible Étiquettes sur ordinateur)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza el texto de las etiquetas en todo el ámbito (destino Etiquetas en escritorio)."
          }
        }
      }
    },
    "Replacing your collection deletes its current decks, notes, cards, media, and settings. A temporary recovery backup is created first.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűjtemény lecserélése törli a jelenlegi paklikat, jegyzeteket, kártyákat, médiafájlokat és beállításokat. Előbb ideiglenes helyreállítási mentés készül."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế bộ sưu tập sẽ xóa các bộ thẻ, ghi chú, thẻ học, tệp đa phương tiện và cài đặt hiện tại. Một bản sao lưu khôi phục tạm thời sẽ được tạo trước."
          }
        },
        "fr": {
          "stringUnit": {
