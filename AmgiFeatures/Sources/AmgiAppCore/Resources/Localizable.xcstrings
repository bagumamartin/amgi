    "This copy of Ijuka is missing part of the assistant feature. Updating or reinstalling Ijuka restores it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka ezen példányából hiányzik az asszisztens egyik összetevője. Frissítés vagy újratelepítés helyreállítja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản Ijuka này bị thiếu một phần của trợ lý. Cập nhật hoặc cài đặt lại Ijuka để khôi phục."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’Ijuka ne contient qu’une partie de la fonction d’assistant. La mise à jour ou la réinstallation d’Ijuka la rétablit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Ijuka no incluye parte de la función de asistente. Actualizar o reinstalar Ijuka la restaurará."
          }
        }
      }
    },
    "This deletes the active profile's collection database, media, and stored credentials. Other profiles are unaffected. The action cannot be undone.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az aktív profil gyűjtemény-adatbázisát, médiafájljait és mentett hitelesítő adatait. A többi profilt nem érinti. Ez a művelet nem vonható vissza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa cơ sở dữ liệu bộ sưu tập, tệp đa phương tiện và thông tin đăng nhập đã lưu của hồ sơ hiện tại. Các hồ sơ khác không bị ảnh hưởng. Không thể hoàn tác."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la base de données de la collection, les médias et les identifiants enregistrés du profil actif. Les autres profils ne sont pas concernés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la base de datos de la colección, los archivos multimedia y las credenciales guardadas del perfil activo. Los demás perfiles no se ven afectados. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "This deletes the note and all its cards. The action cannot be undone.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a jegyzetet és az összes hozzá tartozó kártyát. A művelet nem vonható vissza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa ghi chú và tất cả thẻ liên quan. Không thể hoàn tác."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la note et toutes ses cartes. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la nota y todas sus tarjetas. Esta acción no se puede deshacer."
          }
        }
      }
    },
