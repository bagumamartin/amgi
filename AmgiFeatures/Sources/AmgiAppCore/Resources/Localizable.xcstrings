    "Applies to review cards; the engine rejects the rest with an explanatory error. Last input is remembered for next time.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ismétlőkártyákra érvényes; a motor magyarázó hibaüzenettel elutasítja a többit. A rendszer megjegyzi az utolsó beírt értéket."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho thẻ ôn tập; bộ máy sẽ báo lỗi giải thích nếu dùng cho loại khác. Lần nhập cuối được ghi nhớ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux cartes de révision ; le moteur refuse les autres avec un message explicatif. La dernière valeur saisie est conservée pour la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a las tarjetas de repaso; el motor rechaza las demás con un error explicativo. Se recuerda el último valor introducido."
          }
        }
      }
    },
