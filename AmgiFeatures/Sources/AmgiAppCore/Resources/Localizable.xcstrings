    "Overrides pick an engine for every card of one template and beat the global choice. Stored on this device only.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sablonfelülbírálás külön motort választ a sablon minden kártyájához, és elsőbbséget élvez az általános beállítással szemben. Csak ezen az eszközön tárolódik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi đè mẫu chọn một bộ máy cho mọi thẻ của mẫu đó và ưu tiên hơn cài đặt chung. Chỉ lưu trên thiết bị này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements choisissent un moteur pour chaque carte d’un modèle et prévalent sur le choix général. Ils sont enregistrés uniquement sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las excepciones eligen un motor para cada tarjeta de una plantilla y prevalecen sobre la opción global. Solo se guardan en este dispositivo."
          }
        }
      }
    },
    "Overrides the global choice for every card of this template. Stored on this device only.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felülbírálja az általános beállítást a sablon összes kártyájánál. Csak ezen az eszközön tárolódik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi đè lựa chọn chung cho mọi thẻ của mẫu này. Chỉ được lưu trên thiết bị này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le choix général pour toutes les cartes de ce modèle. Enregistré uniquement sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
