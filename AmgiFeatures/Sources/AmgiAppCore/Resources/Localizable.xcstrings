    "All flashcards, review histories, notes, and imported books stay strictly stored in your local application container on your device.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden tanulókártya, ismétlési előzmény, jegyzet és importált könyv kizárólag az eszköz alkalmazástárhelyén marad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả thẻ ghi nhớ, lịch sử ôn tập, ghi chú và sách đã nhập chỉ được lưu trong vùng chứa ứng dụng cục bộ trên thiết bị."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cartes mémoire, historiques de révision, notes et livres importés restent stockés dans le conteneur local de l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las tarjetas, historiales de repaso, notas y libros importados se guardan exclusivamente en el contenedor local de la app en tu dispositivo."
          }
        }
      }
    },
    "Allow access in Settings, or pick a photo from All Photos.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a hozzáférést a Beállításokban, vagy válassz képet az Összes fotó közül."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
