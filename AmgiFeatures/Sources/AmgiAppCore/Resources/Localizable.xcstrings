    "The deck is paused, but direct Resume could not be recorded. Use Choose cards in Archived.": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pakli szünetel, de a közvetlen folytatás nem lett rögzítve. Válaszd a Kártyák kiválasztása lehetőséget az Archivált résznél."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ đã tạm ngưng nhưng không thể lưu thông tin để tiếp tục trực tiếp. Hãy dùng Chọn thẻ trong mục Đã lưu trữ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet est en pause, mais la reprise directe n’a pas pu être enregistrée. Utilisez « Choisir des cartes » dans les archives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mazo está en pausa, pero no se pudo registrar la reanudación directa. Usa «Elegir tarjetas» en Archivados."
          }
        }
      }
    },
    "Cards were restored, but the Resume record could not be cleared. Review the deck in Browse.": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
