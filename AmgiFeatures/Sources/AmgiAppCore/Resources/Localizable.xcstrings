{
  "sourceLanguage": "en",
  "strings": {
    "App Language": {
      "comment": "Settings › Appearance. Title of the row that overrides the system language for the app, the widget, and the watch.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazás nyelve"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ ứng dụng"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de l’app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma de la app"
          }
        }
      }
    },
    "Enter learning steps like 10m 1d.": {
      "comment": "Shown when Save is refused because the learning/relearning step fields contain something unparseable. The m/h/d letters are the field's syntax, not prose — they stay as they are in every language.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg tanulási lépéseket 10m 1d alakban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập các bước học ở dạng 10m 1d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les étapes d’apprentissage sous la forme 10m 1d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce los pasos de aprendizaje con un formato como 10m 1d."
          }
        }
      }
    },
    "Extra session": {
      "comment": "Study home, sub-label under a filtered deck the app did not create (Anki's custom study).",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiegészítő munkamenet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bổ sung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session supplémentaire"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión extra"
          }
        }
      }
    },
    "Language": {
      "comment": "Settings › Appearance. Section header above the App Language row.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyelv"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma"
          }
        }
      }
    },
    "Redo": {
      "comment": "Browse toolbar/menu, standalone label when there is no operation name to attach.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm lại"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehacer"
          }
        }
      }
    },
    "Redo %@": {
      "comment": "Browse menu: redo verb plus the engine's operation name. The argument is a noun phrase the engine translated, so the verb comes from this catalog and the order may need to change per language. Hungarian uses a colon to introduce the object; Vietnamese does not.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm lại %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehacer %@"
          }
        }
      }
    },
    "Relaunch Ijuka to apply this language to text that comes from the Anki engine, such as card errors and undo names.": {
      "comment": "Settings › Appearance footnote, shown only right after the App Language row changes. The engine's language is fixed when the backend is constructed, so a relaunch is what actually applies it.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítsd újra az Ijuka alkalmazást, hogy ez a nyelv az Anki motortól származó szövegekre is érvényes legyen, például a kártyahibákra és a visszavonások neveire."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại Ijuka để áp dụng ngôn ngữ này cho các văn bản đến từ động cơ Anki, chẳng hạn như lỗi thẻ và tên thao tác hoàn tác."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez Ijuka pour appliquer cette langue aux textes provenant du moteur Anki, comme les erreurs de carte et les noms des actions à annuler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Ijuka para aplicar este idioma a los textos del motor de Anki, como los errores de las tarjetas y los nombres de las acciones deshechas."
          }
        }
      }
    },
    "Resume session": {
      "comment": "Study home, sub-label under a study session deck the app created and left behind.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Munkamenet folytatása"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục phiên"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre la session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar sesión"
          }
        }
      }
    },
    "System": {
      "comment": "Settings › Appearance. The App Language option that defers to the device language. The same word appears for the Appearance and Font pickers on that page.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendszer"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "System follows your device language. Changing this also changes the language the Anki engine uses.": {
      "comment": "Settings › Appearance footnote under the App Language row, shown when no override is set. Quotes the translated word for “System” in the first sentence — the translation of that word has to be updated here too if it changes.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Rendszer” beállítás követi az eszközöd nyelvét. A módosítása az Anki motor nyelvét is megváltoztatja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hệ thống” sẽ theo ngôn ngữ của thiết bị bạn. Thay đổi tùy chọn này cũng sẽ đổi ngôn ngữ của động cơ Anki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit la langue de votre appareil. Ce réglage modifie aussi la langue utilisée par le moteur Anki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue el idioma del dispositivo. Al cambiarlo, también cambia el idioma que usa el motor de Anki."
          }
        }
      }
    },
    "This database is not a readable Mnemosyne collection. Choose a Mnemosyne SQL 1, 2, or 3 database.": {
      "comment": "Import review. Shown when the staged .db could not be read as Mnemosyne. Replaces a previous check that looked for the English words \"mnemosyne\" / \"global_variables\" in the engine's error. “Mnemosyne” is a product name and stays as it is.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az adatbázis nem olvasható Mnemosyne-gyűjtemény. Válassz Mnemosyne SQL 1, 2 vagy 3 adatbázist."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ sở dữ liệu này không phải là bộ sưu tập Mnemosyne đọc được. Hãy chọn cơ sở dữ liệu Mnemosyne SQL 1, 2 hoặc 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base de données ne correspond pas à une collection Mnemosyne lisible. Choisissez une base de données Mnemosyne SQL 1, 2 ou 3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta base de datos no es una colección de Mnemosyne legible. Elige una base de datos Mnemosyne SQL 1, 2 o 3."
          }
        }
      }
    },
    "This file doesn’t appear to be a valid Anki package. It may be damaged or created by a newer version of Anki.": {
      "comment": "Import review. Shown when staging an .apkg / .colpkg / .zip failed. Replaces a previous check that looked for the English words \"zip\" / \"archive\" / \"invalid file\" in the engine's error.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl nem tűnik érvényes Anki-csomagnak. Lehet sérült, vagy az Anki újabb verziója hozta létre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không có vẻ là gói Anki hợp lệ. Tệp có thể đã hỏng hoặc được tạo bởi phiên bản Anki mới hơn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne semble pas être un paquet Anki valide. Il est peut-être endommagé ou a été créé avec une version plus récente d’Anki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no parece ser un paquete de Anki válido. Puede estar dañado o haberse creado con una versión más reciente de Anki."
          }
        }
      }
    },
    "Ijuka couldn’t read this text file. Save it as UTF-8 CSV, TSV, or tab-separated text and try again.": {
      "comment": "Import review. Shown when re-reading the staged text file failed. Replaces a previous check that looked for the English words \"csv\" / \"unicode\" / \"utf-8\" in the engine's error. The format names (UTF-8, CSV, TSV) are not translated.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka nem tudta elolvasni ezt a szövegfájlt. Mentsd UTF-8 CSV, TSV vagy tabulátorral elválasztott szövegként, majd próbáld újra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka không đọc được tệp văn bản này. Hãy lưu dưới dạng CSV, TSV hoặc văn bản phân tách bằng tab, mã hóa UTF-8 rồi thử lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka n’a pas pu lire ce fichier texte. Enregistrez-le au format CSV ou TSV UTF-8, ou en texte séparé par des tabulations, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka no pudo leer este archivo de texto. Guárdalo como CSV o TSV UTF-8, o como texto separado por tabulaciones, y vuelve a intentarlo."
          }
        }
      }
    },
