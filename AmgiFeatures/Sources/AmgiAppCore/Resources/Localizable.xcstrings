            "value": "Campo"
          }
        }
      }
    },
    "Field list loads from the current scope; all fields stay targeted until then.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mezőlista a jelenlegi hatókörből töltődik be; addig minden mező célként szerepel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách trường được tải từ phạm vi hiện tại; trước đó thao tác nhắm tới mọi trường."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des champs se charge à partir du périmètre actuel ; jusque-là, tous les champs restent ciblés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de campos se carga según el ámbito actual; hasta entonces, se incluyen todos los campos."
          }
        }
      }
    },
    "Field mapping": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezők megfeleltetése"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh xạ trường"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspondance des champs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignación de campos"
          }
        }
      }
    },
    "Field names from the notetype that holds your book chapters. Each note becomes a chapter; chapters with the same Book ID collapse into one book.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvfejezeteket tartalmazó jegyzettípus mezőnevei. Minden jegyzetből egy fejezet lesz; az azonos könyvazonosítójú fejezetek egy könyvvé állnak össze."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên các trường của loại ghi chú chứa chương sách. Mỗi ghi chú là một chương; các chương có cùng Book ID sẽ được gộp thành một sách."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms des champs du type de note contenant les chapitres de vos livres. Chaque note devient un chapitre ; les chapitres ayant le même identifiant de livre sont regroupés dans un seul livre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres de los campos del tipo de nota que contiene los capítulos. Cada nota se convierte en un capítulo; los capítulos con el mismo ID de libro se agrupan en un solo libro."
          }
        }
      }
    },
    "Fields": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
