    "Uses Apple's on-device model when available. Turning it off keeps deterministic study summaries.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérhetőség esetén az Apple eszközön futó modelljét használja. Kikapcsolásakor megmaradnak a kiszámítható tanulási összefoglalók."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng mô hình trên thiết bị của Apple khi khả dụng. Tắt tính năng này sẽ giữ lại các bản tóm tắt học tập xác định."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le modèle d’Apple exécuté sur l’appareil lorsqu’il est disponible. Le désactiver conserve les résumés d’étude déterministes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el modelo de Apple en el dispositivo cuando esté disponible. Al desactivarlo, se mantienen los resúmenes de estudio deterministas."
          }
        }
      }
    },
    "Deck names in Spotlight": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Paklinevek a Spotlightban"
          }
        },
        "vi": {
