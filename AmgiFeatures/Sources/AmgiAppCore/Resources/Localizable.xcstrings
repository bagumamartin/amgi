          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm, giới hạn, thứ tự và việc lên lịch lại được áp dụng đồng thời qua AddOrUpdateFilteredDeck, sau đó bộ thẻ được dựng lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche, la limite, l’ordre et la reprogrammation sont appliqués de manière atomique via AddOrUpdateFilteredDeck, puis le paquet est reconstruit."
