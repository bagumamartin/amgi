    "On-device by default": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint az eszközön"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định xử lý trên thiết bị"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil par défaut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositivo de forma predeterminada"
          }
        }
      }
    },
    "Only bounded note results are sent to Apple’s on-device model. Ijuka never sends assistant requests to its own server.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple eszközön futó modellje csak a korlátozott számú egyező jegyzetet kapja meg. Az Ijuka soha nem küldi az asszisztensi kéréseket saját szerverére."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình chạy trên thiết bị của Apple chỉ nhận một số ghi chú khớp trong giới hạn. Ijuka không bao giờ gửi yêu cầu của trợ lý tới máy chủ riêng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des résultats limités de notes sont envoyés au modèle d’Apple exécuté sur l’appareil. Ijuka n’envoie jamais les requêtes de l’assistant à ses propres serveurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía un conjunto limitado de resultados de notas al modelo de Apple en el dispositivo. Ijuka nunca envía las solicitudes del asistente a sus propios servidores."
          }
        }
      }
    },
    "Open Copy in Add Note": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másolat megnyitása a Jegyzet hozzáadása nézetben"
