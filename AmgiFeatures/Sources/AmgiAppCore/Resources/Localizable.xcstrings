          "stringUnit": {
            "state": "translated",
            "value": "Exportar…"
          }
        }
      }
    },
    "Facts are converted to Mnemosyne-specific note types. Review history is preserved for reviewed cards.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tények Mnemosyne-specifikus jegyzettípusokká alakulnak. Az ismételt kártyák előzményei megmaradnak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục kiến thức sẽ được chuyển thành loại ghi chú riêng của Mnemosyne. Lịch sử ôn tập của thẻ đã học được giữ nguyên."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les faits sont convertis en types de note propres à Mnemosyne. L’historique de révision est conservé pour les cartes déjà révisées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se convierten a tipos de nota específicos de Mnemosyne. Se conserva el historial de repaso de las tarjetas ya repasadas."
          }
        }
      }
    },
    "Field": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mező"
          }
        },
        "vi": {
          "stringUnit": {
