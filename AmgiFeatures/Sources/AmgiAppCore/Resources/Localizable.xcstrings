          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thẻ đã được khôi phục nhưng không thể xóa bản ghi tiếp tục. Hãy kiểm tra bộ thẻ trong Duyệt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes ont été restaurées, mais l’enregistrement de reprise n’a pas pu être effacé. Vérifiez le paquet dans Parcourir."
          }
        },
        "es": {
