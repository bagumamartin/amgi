    "New cards queue from position 0; start/step clamp to the queue bounds. Options are remembered for next time.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új kártyák sora a 0. pozíciónál kezdődik; a kezdőérték és a lépésköz a sor határaihoz igazodik. A rendszer megjegyzi ezeket a beállításokat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng đợi thẻ mới bắt đầu ở vị trí 0; giá trị đầu và bước nhảy được giới hạn trong hàng đợi. Tùy chọn được ghi nhớ cho lần sau."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles cartes sont mises en file à partir de la position 0 ; le début et le pas sont limités à la taille de la file. Les options sont conservées pour la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas nuevas se ponen en cola desde la posición 0; el inicio y el paso se limitan a los extremos de la cola. Se recordarán las opciones."
          }
        }
      }
    },
    "New gather priority": {
