    "Reduce the daily workload on specific weekdays. 100% means a normal day; lower values back off reviews on that day.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csökkentsd a napi terhelést a kiválasztott hétköznapokon. A 100 százalék normál napot jelent; az alacsonyabb érték kevesebb ismétlést eredményez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm khối lượng học vào một số ngày trong tuần. 100% là ngày bình thường; giá trị thấp hơn sẽ giảm số lượt ôn tập trong ngày đó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez la charge quotidienne certains jours de la semaine. 100 pour cent correspond à une journée normale ; une valeur plus faible réduit les révisions ce jour-là."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la carga diaria en días concretos de la semana. El 100 % representa un día normal; los valores más bajos reducen los repasos de ese día."
          }
        }
      }
    },
