            "value": "Nombres de mazos en Spotlight"
          }
        }
      }
    },
    "Lets Spotlight and Siri find decks. Note answers are never indexed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy a Spotlight és a Siri megtalálja a paklikat. A jegyzetek válaszai soha nem kerülnek indexelésre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Spotlight và Siri tìm bộ thẻ. Đáp án trong ghi chú không bao giờ được lập chỉ mục."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à Spotlight et Siri de trouver les paquets. Les réponses des notes ne sont jamais indexées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Spotlight y Siri encuentren mazos. Las respuestas de las notas nunca se indexan."
          }
        }
      }
    },
    "Show note titles in system results": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzetcímek megjelenítése a rendszer találatai között"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tiêu đề ghi chú trong kết quả hệ thống"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les titres des notes dans les résultats système"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar títulos de notas en los resultados del sistema"
          }
        }
      }
    },
    "When off, Siri reports match counts without placing private note titles in the response.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva a Siri csak a találatok számát közli, a privát jegyzetcímeket nem jeleníti meg a válaszban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, Siri chỉ thông báo số kết quả khớp mà không đưa tiêu đề ghi chú riêng tư vào câu trả lời."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, Siri indique le nombre de résultats sans inclure les titres privés des notes dans sa réponse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, Siri indica el número de coincidencias sin incluir títulos privados de notas en la respuesta."
          }
        }
      }
    },
