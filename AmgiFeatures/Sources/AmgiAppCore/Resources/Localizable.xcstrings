      "comment": "Browse menu: undo verb plus the engine's operation name. The argument is a noun phrase the engine translated, so the verb comes from this catalog and the order may need to change per language. Hungarian uses a colon to introduce the object; Vietnamese does not.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszavonás: %@"
          }
