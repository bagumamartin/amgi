          }
        }
      }
    },
    "Your configured deck doesn't have any books yet. Import an EPUB or reconfigure your reader source.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállított pakliban még nincsenek könyvek. Importálj EPUB-fájlt, vagy állítsd be újra az olvasási forrást."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ đã cấu hình chưa có sách. Hãy nhập EPUB hoặc cấu hình lại nguồn đọc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet configuré ne contient pas encore de livres. Importez un EPUB ou reconfigurez la source du lecteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mazo configurado aún no tiene libros. Importa un EPUB o vuelve a configurar la fuente del lector."
          }
        }
      }
    },
    "Your local and server collections have diverged. Choose how to reconcile them — Merge is the safest option.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi és a szerveren tárolt gyűjtemény eltér egymástól. Válaszd ki, hogyan szeretnéd összehangolni őket. Az Összevonás a legbiztonságosabb megoldás."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ sưu tập trên máy và máy chủ không còn giống nhau. Hãy chọn cách giải quyết; Gộp là lựa chọn an toàn nhất."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre collection locale et celle du serveur ont divergé. Choisissez comment les réconcilier — Fusionner est l’option la plus sûre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu colección local y la del servidor han divergido. Elige cómo conciliarlas: Combinar es la opción más segura."
          }
        }
      }
    },
    "Your next review is scheduled by the deck limits.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő ismétlés időpontját a pakli korlátai határozzák meg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt ôn tập tiếp theo được lên lịch theo giới hạn của bộ thẻ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prochaine révision est planifiée selon les limites du paquet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo repaso está programado según los límites del mazo."
          }
