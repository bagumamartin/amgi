    "If the active profile changes while the assistant is working, the response is discarded instead of being shown in the wrong collection.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a profil az asszisztens válasza közben megváltozik, a válasz elvész, így nem jelenik meg a rossz gyűjteményben."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu hồ sơ đang dùng thay đổi khi trợ lý xử lý, câu trả lời sẽ bị loại bỏ thay vì hiển thị nhầm trong bộ sưu tập khác."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le profil actif change pendant que l’assistant travaille, sa réponse est ignorée plutôt que d’être affichée dans la mauvaise collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambia el perfil activo mientras el asistente trabaja, se descarta la respuesta para que no aparezca en la colección equivocada."
          }
        }
      }
    },
    "If you configure sync, communication occurs directly between your device and your specified sync server over encrypted HTTPS. Ijuka operates no intermediary servers.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha beállítod a szinkronizálást, az eszközöd közvetlenül és titkosított HTTPS-kapcsolaton kommunikál a megadott szerverrel. Az Ijuka nem üzemeltet köztes szervereket."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thiết lập đồng bộ, thiết bị của bạn giao tiếp trực tiếp với máy chủ đã chỉ định qua HTTPS được mã hóa. Ijuka không vận hành máy chủ trung gian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous configurez la synchronisation, la communication s’effectue directement entre votre appareil et le serveur choisi via HTTPS chiffré. Ijuka n’exploite aucun serveur intermédiaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si configuras la sincronización, la comunicación se realiza directamente entre tu dispositivo y el servidor indicado mediante HTTPS cifrado. Ijuka no opera servidores intermediarios."
          }
        }
      }
    },
    "If you sync, your cards are safe on the server and will come back after a reset.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szinkronizálsz, a kártyáid biztonságban vannak a szerveren, és visszatérnek a visszaállítás után."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đồng bộ, các thẻ sẽ an toàn trên máy chủ và được khôi phục sau khi đặt lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous synchronisez, vos cartes sont conservées sur le serveur et seront restaurées après une réinitialisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sincronizas, tus tarjetas estarán a salvo en el servidor y volverán después de restablecer la app."
          }
        }
      }
    },
    "Ignore": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellőzés"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar"
          }
        }
      }
    },
    "Ijuka creates the file in a private staging location first. You’ll choose where to save it next.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka előbb biztonságos ideiglenes helyre menti a fájlt. Ezután kiválaszthatod, hová kerüljön."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên, Ijuka tạo tệp ở vị trí tạm riêng tư. Sau đó, bạn sẽ chọn nơi lưu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka crée d’abord le fichier dans un espace de préparation privé. Vous choisirez ensuite où l’enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka crea primero el archivo en una ubicación provisional privada. Después elegirás dónde guardarlo."
          }
        }
      }
    },
    "Ijuka includes no third-party tracking SDKs, analytics engines, or advertising networks. We do not collect or share personal identifiers.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka nem tartalmaz külső követő SDK-kat, analitikai rendszereket vagy hirdetési hálózatokat. Nem gyűjtünk és nem osztunk meg személyazonosító adatokat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka không tích hợp SDK theo dõi, công cụ phân tích hay mạng quảng cáo của bên thứ ba. Chúng tôi không thu thập hoặc chia sẻ thông tin nhận dạng cá nhân."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka n’intègre aucun SDK de suivi tiers, outil d’analyse ou réseau publicitaire. Nous ne collectons ni ne partageons aucun identifiant personnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka no incluye SDK de seguimiento de terceros, herramientas de análisis ni redes publicitarias. No recopilamos ni compartimos identificadores personales."
          }
        }
      }
    },
    "Ijuka is built with a strict local-first and privacy-respecting philosophy. We do not track you, sell your data, or serve advertisements.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka a helyi adattárolást és az adatvédelmet helyezi előtérbe. Nem követünk, nem adjuk el az adataidat, és nem jelenítünk meg reklámokat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka được xây dựng theo triết lý ưu tiên lưu trữ cục bộ và tôn trọng quyền riêng tư. Chúng tôi không theo dõi bạn, bán dữ liệu hay hiển thị quảng cáo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka repose sur une approche résolument locale et respectueuse de la vie privée. Nous ne vous suivons pas, ne vendons pas vos données et n’affichons pas de publicités."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka sigue una filosofía local y respetuosa con la privacidad. No te rastreamos, no vendemos tus datos ni mostramos publicidad."
          }
        }
      }
    },
    "Ijuka is busy": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka éppen foglalt"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka đang bận"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka est occupé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka está ocupado"
          }
        }
      }
    },
    "Ijuka syncs with self-hosted and custom Anki-compatible sync servers. Ijuka is an independent application and is not affiliated with, sponsored by, or endorsed by AnkiWeb or Damien Elmes.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka saját üzemeltetésű és egyéni, Anki-kompatibilis szinkronizálási szerverekkel működik. Az Ijuka független alkalmazás, nem áll kapcsolatban az AnkiWebbel vagy Damien Elmessel, és ők nem támogatják."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka đồng bộ với máy chủ tương thích Anki do bạn tự vận hành hoặc tùy chỉnh. Ijuka là ứng dụng độc lập, không liên kết, được tài trợ hay xác nhận bởi AnkiWeb hoặc Damien Elmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka se synchronise avec des serveurs auto-hébergés ou personnalisés compatibles avec Anki. Ijuka est une application indépendante, sans affiliation, parrainage ni approbation d’AnkiWeb ou de Damien Elmes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka se sincroniza con servidores de sincronización autoalojados y personalizados compatibles con Anki. Ijuka es una app independiente, sin afiliación, patrocinio ni respaldo de AnkiWeb o Damien Elmes."
          }
        }
      }
    },
    "Ijuka uses the camera to add pictures to your cards.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka a kamerát használja, hogy képeket adj a kártyáidhoz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka sử dụng camera để thêm ảnh vào thẻ của bạn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka utilise l’appareil photo pour ajouter des images à vos cartes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka usa la cámara para añadir imágenes a tus tarjetas."
          }
        }
      }
    },
    "Ijuka uses the official Anki Rust backend. The backend code is licensed under AGPL-3.0 and remains the work of its authors.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ijuka a hivatalos Anki Rust-motort használja. A motor kódja AGPL-3.0 licencű, szerzői annak eredeti alkotói."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka dùng bộ máy Rust chính thức của Anki. Mã nguồn bộ máy được cấp phép theo AGPL-3.0 và vẫn thuộc về các tác giả."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka utilise le backend Rust officiel d’Anki. Son code est sous licence AGPL-3.0 et reste l’œuvre de ses auteurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijuka usa el backend oficial de Anki en Rust. El código del backend tiene licencia AGPL-3.0 y sigue siendo obra de sus autores."
          }
        }
      }
    },
