    "Tags help group related notes and make them easier to find.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címkék segítenek csoportosítani a kapcsolódó jegyzeteket, és könnyebbé teszik a keresésüket."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ giúp nhóm các ghi chú liên quan và tìm chúng dễ dàng hơn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes permettent de regrouper les notes associées et de les retrouver plus facilement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
