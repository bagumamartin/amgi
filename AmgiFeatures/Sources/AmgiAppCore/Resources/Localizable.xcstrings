    },
    "ijuka.localization.probe": {
      "comment": "Sentinel. AppLocale probes bundles with this key to find the one that actually carries the catalog. A missing key returns the probe's own `value:` argument back, which is this key, so every language's value must differ from it. Never shown to anyone, never remove.",
      "extractionState": "manual",
      "isCommentAutoGenerated": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ijuka-catalog-present"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "ijuka-katalogus-lat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ijuka-co-muc-luc-hien-dien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ijuka.localization.probe.fr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ijuka.localization.probe.es"
          }
        }
      }
    },
    "Needs a decision": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Döntést igényel"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyết định"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À décider"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita una decisión"
          }
        }
      }
    },
    "Still want to study %@?": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Továbbra is szeretnéd tanulni ezt: %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vẫn muốn học %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous toujours étudier %@ ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aún quieres estudiar %@?"
          }
        }
      }
    },
    "Last studied %lld days ago": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utoljára %lld napja tanultad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần học gần nhất cách đây %lld ngày"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étudié pour la dernière fois il y a %lld jours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estudiado por última vez hace %lld días"
          }
        }
      }
    },
    "No study activity in the past year": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt évben nem tanultad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có hoạt động học trong năm qua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité d’étude au cours de l’année écoulée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin actividad de estudio durante el último año"
          }
        }
      }
    },
    "%lld cards waiting": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kártya vár"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld thẻ đang chờ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cartes en attente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tarjetas pendientes"
          }
        }
      }
    },
    "Ready to start this deck?": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készen állsz elkezdeni ezt a paklit?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẵn sàng bắt đầu bộ thẻ này?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à commencer ce paquet ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Listo para empezar este mazo?"
          }
        }
      }
    },
    "%lld new cards waiting": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld új kártya vár"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld thẻ mới đang chờ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nouvelles cartes en attente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tarjetas nuevas pendientes"
          }
        }
      }
    },
    "Does this study pace still suit you?": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még megfelelő neked ez a tanulási tempó?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp độ học này vẫn phù hợp với bạn?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rythme d’étude vous convient-il toujours ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Este ritmo de estudio te sigue funcionando?"
          }
        }
      }
    },
    "%lld new cards · about %lld days to introduce at %lld/day": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld új kártya · körülbelül %lld nap az összes bevezetése napi %lld kártyával"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld thẻ mới · khoảng %lld ngày để học lượt đầu với %lld thẻ/ngày"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nouvelles cartes · environ %lld jours pour les introduire à raison de %lld par jour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tarjetas nuevas · unos %lld días para introducirlas a %lld al día"
          }
        }
      }
    },
    "What would you like to do with this deck?": {
      "comment": "Library deck decision flow.",
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
