    "Included tags match any selection. Cards matching any excluded tag are removed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott címkék közül bármelyikkel egyező kártyák bekerülnek. A kizárt címkékkel egyező kártyák kimaradnak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ có bất kỳ nhãn nào được chọn sẽ được thêm vào. Thẻ có nhãn bị loại trừ sẽ bị bỏ qua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes incluses correspondent à au moins une sélection. Les cartes correspondant à une étiquette exclue sont supprimées."
          }
