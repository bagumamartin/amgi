        }
      }
    },
    "Fields are separated by tabs. Anki's text exporter writes one note per row.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mezőket tabulátor választja el. Az Anki szöveges exportálója soronként egy jegyzetet ír ki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường được phân cách bằng tab. Công cụ xuất văn bản của Anki ghi mỗi ghi chú trên một hàng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs sont séparés par des tabulations. L’exportateur texte d’Anki écrit une note par ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos están separados por tabulaciones. El exportador de texto de Anki escribe una nota por fila."
          }
        }
      }
