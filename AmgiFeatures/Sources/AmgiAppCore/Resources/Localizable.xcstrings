    "Wait, or study them now.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várj, vagy tanuld meg őket most."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chờ, hoặc học ngay bây giờ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
