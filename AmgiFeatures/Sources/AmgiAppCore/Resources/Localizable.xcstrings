    "A collection package includes all decks, notes, cards, scheduling, settings, and—when enabled—media.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűjteménycsomag minden paklit, jegyzetet, kártyát, ütemezést és beállítást tartalmaz, valamint igény esetén a médiafájlokat is."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói bộ sưu tập bao gồm tất cả bộ thẻ, ghi chú, thẻ học, lịch ôn tập và cài đặt; có thể kèm cả tệp đa phương tiện."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquet de collection comprend tous les paquets, notes, cartes, données de planification, réglages et, si cette option est activée, les médias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete de colección incluye todos los mazos, notas, tarjetas, programación, ajustes y, si está habilitado, archivos multimedia."
          }
        }
      }
    },
