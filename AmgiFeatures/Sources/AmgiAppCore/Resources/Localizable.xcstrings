    "All current decks, notes, cards, media, and settings will be replaced. Ijuka creates a temporary recovery package first.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi paklik, jegyzetek, kártyák, médiafájlok és beállítások lecserélődnek. Az Ijuka előbb ideiglenes helyreállítási csomagot készít."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả bộ thẻ, ghi chú, thẻ học, tệp đa phương tiện và cài đặt hiện tại sẽ bị thay thế. Ijuka sẽ tạo gói khôi phục tạm thời trước."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les paquets, notes, cartes, médias et réglages actuels seront remplacés. Ijuka crée d’abord un paquet de récupération temporaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán todos los mazos, notas, tarjetas, archivos multimedia y ajustes actuales. Ijuka creará primero un paquete temporal de recuperación."
          }
        }
      }
    },
    "All decks": {
      "extractionState": "manual",
