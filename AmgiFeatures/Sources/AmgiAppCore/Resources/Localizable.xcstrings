    "Powers smarter deck icons and meaning-based search. Updates download automatically within this network setting.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligensebb pakliikonokat és jelentésalapú keresést tesz lehetővé. A frissítések automatikusan letöltődnek az adott hálózati beállítás mellett."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ biểu tượng bộ thẻ thông minh hơn và tìm kiếm theo ý nghĩa. Các bản cập nhật được tải tự động theo cài đặt mạng này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliore les icônes des paquets et la recherche par sens. Les mises à jour sont téléchargées automatiquement selon ce réglage réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora los iconos de los mazos y la búsqueda por significado. Las actualizaciones se descargan automáticamente según este ajuste de red."
