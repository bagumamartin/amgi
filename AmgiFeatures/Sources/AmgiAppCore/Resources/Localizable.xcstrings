    "Saved searches sync to every device via your collection config — desktop Anki sees them too.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett keresések a gyűjtemény beállításaival minden eszközre szinkronizálódnak, így az asztali Anki is látja őket."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm đã lưu được đồng bộ tới mọi thiết bị qua cấu hình bộ sưu tập; Anki trên máy tính cũng sẽ thấy chúng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches enregistrées se synchronisent sur tous les appareils via la configuration de votre collection ; Anki sur ordinateur les voit également."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las búsquedas guardadas se sincronizan con todos los dispositivos mediante la configuración de la colección; también aparecen en Anki de escritorio."
          }
        }
      }
    },
    "Saving an existing name asks before overwriting. Rename rejects collisions.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meglévő név mentésekor a rendszer rákérdez a felülírásra. Átnevezéskor nem engedélyezi az ütközést."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tên đã tồn tại sẽ yêu cầu xác nhận ghi đè. Đổi tên sẽ từ chối tên bị trùng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d’écraser un nom existant, une confirmation est demandée. Le renommage refuse les doublons."
          }
        },
