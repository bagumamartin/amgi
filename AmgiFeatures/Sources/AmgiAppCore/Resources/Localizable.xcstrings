    "Each profile keeps its own collection, sync login, and review history. Switching applies immediately.": {
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden profilnak saját gyűjteménye, szinkronizálási bejelentkezése és ismétlési előzménye van. A váltás azonnal érvénybe lép."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hồ sơ có bộ sưu tập, thông tin đăng nhập đồng bộ và lịch sử ôn tập riêng. Việc chuyển đổi có hiệu lực ngay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil possède sa propre collection, sa connexion de synchronisation et son historique de révision. Le changement est immédiat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil tiene su propia colección, conexión de sincronización e historial de repaso. El cambio se aplica de inmediato."
          }
        }
      }
    },
