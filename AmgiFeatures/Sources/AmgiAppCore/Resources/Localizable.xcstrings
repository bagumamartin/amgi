    "Create a collection package, then choose Files, iCloud Drive, or another Apple destination in the system Save panel.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre gyűjteménycsomagot, majd válaszd a Fájlok, az iCloud Drive vagy egy másik Apple-célhelyet a rendszer Mentés paneljén."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo gói bộ sưu tập, rồi chọn Tệp, iCloud Drive hoặc nơi lưu trữ khác của Apple trong bảng Lưu của hệ thống."
          }
        },
        "fr": {
