    "Its cards will return to their original decks before this selection is built. No cards will be deleted.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyái visszakerülnek az eredeti paklijukba, mielőtt ez a választás felépül. Egyetlen kártya sem törlődik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ sẽ được trả về bộ thẻ ban đầu trước khi tạo lựa chọn này. Không thẻ nào bị xóa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses cartes retrouveront leurs paquets d’origine avant la création de cette sélection. Aucune carte ne sera supprimée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus tarjetas volverán a sus mazos originales antes de crear esta selección. No se eliminará ninguna tarjeta."
          }
        }
      }
    },
