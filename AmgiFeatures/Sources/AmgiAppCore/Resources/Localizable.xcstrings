    "Stops syncing. Your local collection is unaffected.": {
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítja a szinkronizálást. A helyi gyűjteményed megmarad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đồng bộ. Bộ sưu tập cục bộ của bạn không bị ảnh hưởng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la synchronisation. Votre collection locale n’est pas affectée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la sincronización. Tu colección local no se verá afectada."
          }
        }
      }
    },
    "Removes the server, credentials, and switches the app to local-only mode.": {
      "extractionState": "manual",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a szervert és a hitelesítő adatokat, majd helyi módra váltja az alkalmazást."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa máy chủ và thông tin đăng nhập, rồi chuyển ứng dụng sang chế độ chỉ dùng cục bộ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le serveur et les identifiants, puis fait passer l’app en mode local uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el servidor y las credenciales, y cambia la app al modo solo local."
          }
        }
      }
    },
