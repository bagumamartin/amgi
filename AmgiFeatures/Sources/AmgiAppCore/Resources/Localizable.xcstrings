    "Deletes the local collection and sync credentials for this profile. Other profiles are untouched.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli a profil helyi gyűjteményét és szinkronizálási hitelesítő adatait. A többi profilt nem érinti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bộ sưu tập cục bộ và thông tin đăng nhập đồng bộ của hồ sơ này. Các hồ sơ khác không bị ảnh hưởng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la collection locale et les identifiants de synchronisation de ce profil. Les autres profils ne sont pas concernés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la colección local y las credenciales de sincronización de este perfil. Los demás perfiles no se modifican."
          }
        }
      }
    },
    "Deletes this profile's collection and credentials. You will need to sync or re-import after.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli a profil gyűjteményét és hitelesítő adatait. Ezután szinkronizálnod vagy újra importálnod kell."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bộ sưu tập và thông tin đăng nhập của hồ sơ này. Sau đó, bạn cần đồng bộ hoặc nhập lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la collection et les identifiants de ce profil. Vous devrez ensuite synchroniser ou importer à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la colección y las credenciales de este perfil. Después tendrás que sincronizar o volver a importar."
          }
        }
      }
    },
    "Desktop Forget options. Unchecked restores cards to the end of the new queue without clearing counts.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az asztali Elfelejtés-beállítások. Ha nincs bejelölve, a kártyák az ismétlésszámok törlése nélkül az új pakli végére kerülnek vissza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn Quên trên máy tính. Bỏ chọn sẽ đưa thẻ xuống cuối hàng chờ thẻ mới mà không xóa số lần ôn tập."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Options d’oubli sur ordinateur. Si elle n’est pas cochée, les cartes reviennent à la fin de la file des nouvelles cartes sans effacer les compteurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opciones de olvido de escritorio. Si no se marca, las tarjetas vuelven al final de la cola de nuevas sin borrar los recuentos."
          }
        }
      }
    },
